#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
generator="${script_dir}/generate-fix-prompts"
repo_dir="$(mktemp -d)"
work_dir="$(mktemp -d)"

cleanup() {
  rm -rf "$repo_dir" "$work_dir"
}
trap cleanup EXIT

mkdir -p "${repo_dir}/quality-evidence/001-fixture"

cat > "${repo_dir}/quality-policy.yaml" <<'YAML'
name: Fixture policy
summary: Shared proof posture for the fixture repo.
defaults:
  preferred_modalities: [unit, contract, integration]
  minimum_depth: INDIRECT
  require_direct_evidence: false
rules:
  - id: release-critical-floor
    when:
      min_risk_weight: 5
    minimum_depth: DIRECT
    require_direct_evidence: true
    require_gate: true
YAML

cat > "${repo_dir}/quality-evidence/001-fixture/quality-map.yaml" <<'YAML'
target:
  id: 001-fixture
  name: Fixture Feature
  scope: feature
  source_refs:
    - path: specs/001-fixture/spec.md
expectations:
  - id: covered-context
    title: Covered context should not become a prompt
    source_type: SOURCE
    category: other
    priority: P0
    risk:
      weight: 5
      rationale: Important and already structurally covered.
    evidence:
      - id: covered-context-test
        type: integration
        path: tests/covered-context.test.ts
        command: pnpm test tests/covered-context.test.ts
        depth: DIRECT
        reliability: STRONG
        contexts: [pr-ci]

  - id: sentinel-command
    title: Missing evidence should preserve notes and linked paths
    source_type: SOURCE
    category: ops
    priority: P2
    risk:
      weight: 3
      rationale: Missing evidence should be closed with an artifact.
    evidence:
      - id: sentinel-command-evidence
        type: other
        command: No evidence artifact found
        depth: MISSING
      - id: linked-runbook-evidence
        type: manual
        path: tests/agent/001-fixture/manual-check.md
        command: see linked artifact or runbook
        depth: MANUAL
        reliability: MODERATE
    proof_gap:
      summary: The current evidence artifact is not attached.
      next_step: Attach or author the missing verification artifact.

  - id: next-proof
    title: Explicit recommended action is actionable
    source_type: SOURCE
    category: ui
    priority: P1
    risk:
      weight: 2
      rationale: Browser proof is useful before release.
    evidence:
      - id: next-proof-test
        type: integration
        path: tests/next-proof.test.ts
        command: pnpm test / pnpm typecheck
        depth: DIRECT
        reliability: STRONG
        contexts: [local]
    proof_gap:
      summary: Browser-only behavior is still worth checking before release.
      next_step: Run the browser verification suite.

  - id: docs-only-source-snapshot
    title: Docs-only source snapshot still needs runtime proof
    source_type: SOURCE
    category: other
    priority: P1
    risk:
      weight: 3
      rationale: Docs-only evidence can mislead agents into stopping after a framing cleanup.
    evidence:
      - id: docs-only-source-snapshot-proof
        type: static
        path: specs/001-fixture/spec.md
        depth: STATIC
        reliability: STRONG

  - id: policy-gap
    title: Local-only proof does not satisfy declared proof posture
    source_type: SOURCE
    category: data
    priority: P1
    risk:
      weight: 4
      rationale: Data-sensitive checks should be provable in a gate context.
    policy_override:
      required_contexts: [pr-ci]
      require_gate: true
      notes: Require a CI gate for this expectation.
    evidence:
      - id: policy-gap-proof
        type: integration
        path: tests/policy-gap.test.ts
        command: pnpm test tests/policy-gap.test.ts
        depth: DIRECT
        reliability: STRONG
        contexts: [local]

  - id: workflow-smoke
    title: Workflow-backed smoke check is runtime-observed, not rerun
    source_type: SOURCE
    category: ops
    priority: P1
    risk:
      weight: 4
      rationale: A broken release smoke gate breaks every downstream job.
    evidence:
      - id: workflow-smoke-proof
        type: smoke
        path: .github/workflows/release-ci-runner.yml
        test_case: agent_payload
        command: Smoke baked runner image
        depth: MISSING
        reliability: UNKNOWN
        contexts: [ci]
    proof_gap:
      summary: The smoke gate has no runtime observation backing yet.
      next_step: Add a manifest observation source for the release smoke checks.
YAML

json_output="$("$generator" "$repo_dir" --format json)"
include_covered_json="$("$generator" "$repo_dir" --format json --include-covered)"

node - "$json_output" "$include_covered_json" <<'JS'
const records = JSON.parse(process.argv[2]);
const includeCoveredRecords = JSON.parse(process.argv[3]);
const ids = records.map((record) => record.expectation_id);

function assert(condition, message) {
  if (!condition) {
    console.error(message);
    process.exit(1);
  }
}

assert(!ids.includes("covered-context"), "directly covered expectation should not generate a default prompt");
assert(ids.includes("sentinel-command"), "missing evidence should generate a prompt");
assert(ids.includes("next-proof"), "open proof_gap should generate a prompt");
assert(ids.includes("docs-only-source-snapshot"), "static-only proof should generate a proof-upgrade prompt");
assert(ids.includes("policy-gap"), "policy override gaps should generate a prompt");
assert(ids.includes("workflow-smoke"), "workflow-backed smoke gap should generate a prompt");

const sentinel = records.find((record) => record.expectation_id === "sentinel-command");
assert(sentinel !== undefined, "sentinel fixture record was not found");
assert(!sentinel.verification_checks.includes("No evidence artifact found"), "missing-artifact sentinel should not be a rerunnable check");
assert(!sentinel.verification_checks.includes("see linked artifact or runbook"), "runbook sentinel should not be a rerunnable check");
assert(sentinel.verification_checks.includes("tests/agent/001-fixture/manual-check.md"), "agent test path should remain a verification check");
assert(sentinel.evidence_notes.includes("No evidence artifact found"), "missing-artifact sentinel should be preserved as an evidence note");
assert(sentinel.evidence_notes.includes("see linked artifact or runbook"), "runbook sentinel should be preserved as an evidence note");

const nextProof = records.find((record) => record.expectation_id === "next-proof");
assert(nextProof !== undefined, "recommended action fixture record was not found");
assert(nextProof.closure_mode === "proof_gap", "open proof gap should use proof_gap closure mode");
assert(nextProof.verification_checks.includes("pnpm test"), "slash-separated command shorthand should include pnpm test");
assert(nextProof.verification_checks.includes("pnpm typecheck"), "slash-separated command shorthand should include pnpm typecheck");
assert(!nextProof.verification_checks.includes("pnpm test / pnpm typecheck"), "slash-separated command shorthand should not remain a single check");
assert(nextProof.recommended_action.includes("Run the browser verification suite"), "proof_gap next_step should become the recommended action");

const docsOnly = records.find((record) => record.expectation_id === "docs-only-source-snapshot");
assert(docsOnly !== undefined, "docs-only source snapshot fixture record was not found");
assert(docsOnly.closure_mode === "proof_upgrade", "docs-only source snapshot should require a proof upgrade");
assert(docsOnly.closure_condition.includes("stronger direct proof"), "docs-only source snapshot should state the stronger-proof closure condition");
assert(docsOnly.non_closing_changes.some((item) => item.includes("weak, manual, static, or indirect evidence")), "docs-only source snapshot should warn that reframing weak evidence is not sufficient");
assert(docsOnly.recommended_action.includes("Add stronger direct proof"), "docs-only source snapshot should recommend stronger direct proof");
assert(docsOnly.prompt.includes("Closure condition on next scan:"), "prompt should include the closure condition section");
assert(docsOnly.prompt.includes("Changes that do not count as success by themselves:"), "prompt should include the non-closing changes section");
assert(docsOnly.prompt.includes("treat this task as complete only if the next scan stops reporting this quality check as open"), "prompt should define success in terms of the next scan result");

const policyGap = records.find((record) => record.expectation_id === "policy-gap");
assert(policyGap !== undefined, "policy-gap fixture record was not found");
assert(policyGap.closure_mode === "policy_gap", "policy override mismatch should use policy_gap closure mode");
assert(policyGap.problem.includes("required contexts missing: pr-ci"), "policy gap should explain the missing required context");
assert(policyGap.problem.includes("gate-capable proof context"), "policy gap should explain the missing gate context");
assert(policyGap.source_of_truth_inputs.includes("quality-policy.yaml"), "repo-root quality-policy.yaml should be a source-of-truth input");

const workflowSmoke = records.find((record) => record.expectation_id === "workflow-smoke");
assert(workflowSmoke !== undefined, "workflow-smoke fixture record was not found");
assert(!workflowSmoke.verification_checks.includes("Smoke baked runner image"), "workflow-backed command is a human pointer, not a rerunnable check");
assert(!workflowSmoke.verification_checks.includes(".github/workflows/release-ci-runner.yml"), "workflow file path should not be surfaced as a verification check");
assert(workflowSmoke.evidence_notes.includes("Smoke baked runner image"), "workflow-backed command should be preserved as an evidence note");

const coveredContext = includeCoveredRecords.find((record) => record.expectation_id === "covered-context");
assert(coveredContext !== undefined, "--include-covered should include expectations without open proof gaps");
JS

target_json="$("$generator" "$repo_dir" --format json --target 001-fixture)"
node - "$target_json" <<'JS'
const records = JSON.parse(process.argv[2]);
if (records.length === 0 || !records.every((record) => record.target_id === "001-fixture")) {
  console.error("--target 001-fixture should only include the fixture feature prompts");
  process.exit(1);
}
JS

(
  cd "$work_dir"
  "$generator" "$repo_dir" --limit 1 --output quality-evidence/fix-prompts.md
)

if [[ ! -f "${repo_dir}/quality-evidence/fix-prompts.md" ]]; then
  echo "relative --output should write under the repo root" >&2
  exit 1
fi

if [[ -f "${work_dir}/quality-evidence/fix-prompts.md" ]]; then
  echo "relative --output must not write under the caller cwd" >&2
  exit 1
fi

echo "generate-fix-prompts regression tests passed"
