{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shiplight.dev/schemas/quality-evidence/quality-policy.schema.json",
  "title": "Quality Proof Strategy Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "summary", "defaults"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "contexts": {
      "type": "array",
      "items": { "$ref": "#/$defs/context" }
    },
    "defaults": { "$ref": "#/$defs/posture" },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "modality_guidance": {
      "type": "array",
      "items": { "$ref": "#/$defs/modalityGuidance" }
    },
    "guardrails": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "floors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceType": {
      "enum": ["unit", "contract", "integration", "e2e", "agent", "manual", "telemetry", "static", "smoke", "script", "other"]
    },
    "category": {
      "enum": ["billing", "auth", "security", "data", "ui", "api", "ops", "performance", "privacy", "compliance", "other"]
    },
    "priority": {
      "enum": ["P0", "P1", "P2", "P3", "UNKNOWN"]
    },
    "sourceType": {
      "enum": ["SOURCE", "IMPLEMENTATION", "INFERRED"]
    },
    "proofDepthTarget": {
      "enum": ["DIRECT", "INDIRECT", "STATIC", "MANUAL", "IMPLICIT"]
    },
    "posture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferred_modalities": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceType" }
        },
        "discouraged_modalities": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceType" }
        },
        "required_modalities": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceType" }
        },
        "required_contexts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "minimum_depth": { "$ref": "#/$defs/proofDepthTarget" },
        "require_direct_evidence": { "type": "boolean" },
        "require_multi_layer": { "type": "boolean" },
        "require_gate": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "ruleWhen": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "categories": {
          "type": "array",
          "items": { "$ref": "#/$defs/category" }
        },
        "priorities": {
          "type": "array",
          "items": { "$ref": "#/$defs/priority" }
        },
        "source_types": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceType" }
        },
        "min_risk_weight": { "type": "integer", "minimum": 1, "maximum": 5 },
        "max_risk_weight": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "rule": {
      "allOf": [
        { "$ref": "#/$defs/posture" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "when": { "$ref": "#/$defs/ruleWhen" }
          }
        }
      ]
    },
    "modalityGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modality"],
      "properties": {
        "modality": { "$ref": "#/$defs/evidenceType" },
        "use_for": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "avoid_for": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
