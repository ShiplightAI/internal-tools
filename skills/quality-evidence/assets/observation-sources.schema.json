{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shiplight.dev/schemas/quality-center/observation-sources.schema.json",
  "title": "Quality Center Observation Source Profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["profiles"],
  "properties": {
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "url": { "$ref": "#/$defs/nonEmptyString" },
        "label": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_env": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "evidence_id"],
      "properties": {
        "subject_id": { "$ref": "#/$defs/nonEmptyString" },
        "expectation_id": { "$ref": "#/$defs/nonEmptyString" },
        "evidence_id": { "$ref": "#/$defs/nonEmptyString" },
        "note": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "junitMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_names", "observations"],
      "properties": {
        "file": { "$ref": "#/$defs/nonEmptyString" },
        "class_name": { "$ref": "#/$defs/nonEmptyString" },
        "test_names": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/observation" }
        }
      }
    },
    "playwrightMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_names", "observations"],
      "properties": {
        "file": { "$ref": "#/$defs/nonEmptyString" },
        "project_name": { "$ref": "#/$defs/nonEmptyString" },
        "test_names": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/observation" }
        }
      }
    },
    "githubActionsStepMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_name", "observations"],
      "properties": {
        "workflow_name": { "$ref": "#/$defs/nonEmptyString" },
        "job_name": { "$ref": "#/$defs/nonEmptyString" },
        "step_name": { "$ref": "#/$defs/nonEmptyString" },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/observation" }
        }
      }
    },
    "junitAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "artifact_path", "mappings"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "const": "junit" },
        "artifact_path": { "$ref": "#/$defs/nonEmptyString" },
        "mappings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/junitMapping" }
        }
      }
    },
    "playwrightJsonAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "artifact_path", "mappings"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "const": "playwright-json" },
        "artifact_path": { "$ref": "#/$defs/nonEmptyString" },
        "mappings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/playwrightMapping" }
        }
      }
    },
    "githubActionsStepAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "mappings"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "const": "github-actions-step" },
        "mappings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/githubActionsStepMapping" }
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "workflow", "artifact_names"],
      "properties": {
        "repo": { "$ref": "#/$defs/nonEmptyString" },
        "workflow": { "$ref": "#/$defs/nonEmptyString" },
        "artifact_names": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "branch": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "localFolder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "source_kind", "adapters"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "source_kind": {
          "enum": ["github-actions", "local-folder"]
        },
        "source_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "auth": { "$ref": "#/$defs/auth" },
        "github": { "$ref": "#/$defs/github" },
        "local_folder": { "$ref": "#/$defs/localFolder" },
        "adapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/junitAdapter" },
              { "$ref": "#/$defs/playwrightJsonAdapter" },
              { "$ref": "#/$defs/githubActionsStepAdapter" }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_kind": { "const": "github-actions" }
            }
          },
          "then": {
            "required": ["github"]
          }
        },
        {
          "if": {
            "properties": {
              "source_kind": { "const": "local-folder" }
            }
          },
          "then": {
            "required": ["local_folder"],
            "properties": {
              "adapters": {
                "type": "array",
                "not": {
                  "contains": {
                    "type": "object",
                    "required": ["type"],
                    "properties": {
                      "type": { "const": "github-actions-step" }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
