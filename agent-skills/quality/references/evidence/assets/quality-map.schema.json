{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shiplight.dev/schemas/quality-evidence/quality-map.schema.json",
  "title": "Quality Evidence Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["target", "expectations"],
  "properties": {
    "structure_provenance": { "$ref": "#/$defs/structureProvenance" },
    "checks_reviewed": { "type": "boolean" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "scope", "source_refs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["feature", "module", "pr", "ticket"] },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceRef" }
        }
      }
    },
    "expectations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/expectation" }
    }
  },
  "$defs": {
    "gapCategory": {
      "enum": ["missing", "blocked", "stale", "deferred", "manual-only", "weak", "failing", "unavailable"]
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "anchor": { "type": "string" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "status": { "enum": ["planned", "in_progress", "done", "deferred", "blocked", "unknown"] }
      }
    },
    "policyOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferred_modalities": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceType" }
        },
        "discouraged_modalities": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceType" }
        },
        "required_modalities": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceType" }
        },
        "required_contexts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "require_gate": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "proofGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "next_step": { "type": ["string", "null"] }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "source_type", "category", "priority", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "source_type": { "enum": ["SOURCE", "IMPLEMENTATION", "INFERRED"] },
        "structure_provenance": { "$ref": "#/$defs/structureProvenance" },
        "source_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "category": {
          "enum": ["billing", "auth", "security", "data", "ui", "api", "ops", "performance", "privacy", "compliance", "other"]
        },
        "priority": { "enum": ["P0", "P1", "P2", "P3", "UNKNOWN"] },
        "tasks": {
          "type": "array",
          "items": { "$ref": "#/$defs/task" }
        },
        "policy_override": { "$ref": "#/$defs/policyOverride" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "proof_gap": { "$ref": "#/$defs/proofGap" },
        "accepted_gaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/gapCategory" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/evidenceType" },
        "path": { "type": "string" },
        "test_case": { "type": "string" },
        "url": { "type": "string" },
        "command": { "type": "string" },
        "contexts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": "string" }
      }
    },
    "evidenceType": {
      "enum": ["unit", "contract", "integration", "e2e", "agent", "manual", "telemetry", "static", "smoke", "script", "other"]
    },
    "structureProvenance": {
      "enum": ["spec", "user_authored", "agent_generated", "inferred_brownfield", "unspecified"]
    }
  }
}
